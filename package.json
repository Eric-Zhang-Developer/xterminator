{
  "name": "xterminator",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for Xterminator: a Chrome extension that hides the For you timeline on X/Twitter, plus its landing page.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @xterminator/extension",
    "dev": "npm run dev -w @xterminator/extension",
    "typecheck": "npm run typecheck -w @xterminator/extension",
    "dev:landing": "npm run dev -w @xterminator/landing"
  }
}
