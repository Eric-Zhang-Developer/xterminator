{
  "manifest_version": 3,
  "name": "Xterminator",
  "description": "Hide the central X/Twitter home feed.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Xterminator"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
